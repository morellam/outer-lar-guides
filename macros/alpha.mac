/RMG/Manager/Logging/LogLevel detail

/RMG/Processes/OpticalPhysics true
/RMG/Processes/OpticalPhysicsMaxOneWLSPhoton true

# uncomment to use the remage "optical" tree
###/RMG/Geometry/RegisterDetector Optical sipm_.* 00

###/RMG/Output/ActivateOutputScheme Track
/RMG/Output/ActivateOutputScheme LGOutputScheme

/run/initialize

###/RMG/Output/Track/StoreOpticalPhotons true
/RMG/Output/NtuplePerDetector false
/RMG/Output/LGOutputScheme/StoreAllGuidePhotons false

/RMG/Generator/Select GPS
/gps/position {x} {y} {z} mm
/gps/particle alpha
/gps/direction 0 -1 0
/gps/energy 5000 keV

/run/beamOn {nev}
